@page
@model CarbonFootprint.Web.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "忘記密碼";
    ViewData["BodyClass"] = "auth-page";
}

<section class="auth-shell auth-shell--setup" aria-labelledby="forgot-password-title">
    <div class="auth-visual">
        <div class="auth-visual__content">
            <span class="eyebrow eyebrow-light">ACCOUNT RECOVERY</span>
            <h1>重設帳號<br />登入密碼</h1>
            <p>輸入註冊使用的 Email；若帳號可重設密碼，系統會寄出連結。</p>
        </div>
    </div>

    <div class="auth-panel">
        <div class="auth-card">
            <span class="eyebrow">帳號復原</span>
            <h2 id="forgot-password-title">忘記密碼</h2>
            <p class="auth-card__intro">為保護帳號，送出後一律顯示相同結果。</p>

            <form method="post" asp-antiforgery="true" class="auth-form" novalidate>
                <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
                <div class="field-group">
                    <label asp-for="Input.Email"></label>
                    <div class="field-control">
                        <input asp-for="Input.Email" autocomplete="email" placeholder="name@example.com" />
                    </div>
                    <span asp-validation-for="Input.Email" class="field-error"></span>
                </div>

                <button type="submit" class="btn-carbon btn-carbon--wide">
                    寄送重設密碼連結
                    <span aria-hidden="true">→</span>
                </button>
            </form>

            <a class="auth-back" href="/Identity/Account/Login">← 返回登入</a>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
