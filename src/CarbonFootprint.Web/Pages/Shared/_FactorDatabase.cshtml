@model CarbonFootprint.Web.Pages.WorkspaceModel
@using CarbonFootprint.Domain.Modules.Factors

<section class="card h-100 workspace-card" id="factor-database">
    <div class="card-body">
        <div class="workspace-card-heading">
            <span class="workspace-step">05</span>
            <div>
                <h2 class="h4">碳足跡係數資料庫</h2>
                <p>集中維護公開來源與自行建立的係數版本；盤查階段只負責查詢及選用已發布係數。</p>
            </div>
        </div>

        <section class="workspace-subpanel mb-3">
            <h3 class="h6">同步環境部公開係數</h3>
            <p>資料來源：環境部「碳足跡排放係數」資料集 CFP_P_02。重新整理頁面不會匯入資料；請按下方按鈕執行同步。同步只建立草稿，不會覆寫已發布版本或歷史計算。</p>
            <form method="post" asp-page="/Workspace" asp-page-handler="SyncMoenvFactors" asp-route-section="factors">
                <button class="btn btn-primary" type="submit">同步並匯入係數草稿</button>
            </form>
            <p class="workspace-select-help mt-2 mb-0">未設定自有金鑰時，系統會從政府資料開放平臺取得目前的官方 JSON 公開下載網址。</p>
        </section>

        <details class="lifecycle-factor-registry" open>
            <summary>手動新增係數</summary>
            <form method="post" asp-page="/Workspace" asp-page-handler="CreateFactor" asp-route-section="factors">
                <div class="lifecycle-form-grid">
                    <div class="lifecycle-field">
                        <label class="form-label" for="factorName">係數名稱</label>
                        <input class="form-control" id="factorName" name="factorName" required />
                    </div>
                    <div class="lifecycle-field">
                        <label class="form-label" for="factorValue">係數值</label>
                        <input class="form-control" type="number" step="any" min="0" id="factorValue" name="factorValue" required />
                    </div>
                    <div class="lifecycle-field">
                        <label class="form-label" for="denominatorUnitCode">係數分母單位</label>
                        <select class="form-select" id="denominatorUnitCode" name="denominatorUnitCode" required>
                            @foreach (var unit in Model.Units)
                            {
                                <option value="@unit.Code">kgCO2e／@unit.Code</option>
                            }
                        </select>
                    </div>
                    <div class="lifecycle-field">
                        <label class="form-label" for="factorSourceType">來源類型</label>
                        <select class="form-select" id="factorSourceType" name="factorSourceType" required data-controlled-other data-other-target="#factorSourceTypeOther">
                            <option value="government-database">主管機關／政府資料庫</option>
                            <option value="lca-database">國際 LCA 資料庫</option>
                            <option value="academic-paper">學術文獻／論文</option>
                            <option value="test-report">檢測／查驗報告</option>
                            <option value="supplier-data">供應商一級資料</option>
                            <option value="self-calculated">自廠計算係數</option>
                            <option value="__other__">其他（自行輸入）</option>
                        </select>
                        <input class="form-control mt-2" id="factorSourceTypeOther" name="factorSourceTypeOther" placeholder="請輸入其他來源類型" hidden />
                    </div>
                    <div class="lifecycle-field">
                        <label class="form-label" for="factorGeography">適用地域</label>
                        <select class="form-select" id="factorGeography" name="factorGeography" required data-controlled-other data-other-target="#factorGeographyOther">
                            <option value="TW">台灣</option>
                            <option value="Global">全球</option>
                            <option value="East Asia">東亞</option>
                            <option value="EU">歐盟</option>
                            <option value="US">美國</option>
                            <option value="CN">中國</option>
                            <option value="JP">日本</option>
                            <option value="__other__">其他（自行輸入）</option>
                        </select>
                        <input class="form-control mt-2" id="factorGeographyOther" name="factorGeographyOther" placeholder="請輸入其他地域" hidden />
                    </div>
                    <div class="lifecycle-field">
                        <label class="form-label" for="factorValidFrom">有效起日</label>
                        <input class="form-control" type="date" id="factorValidFrom" name="factorValidFrom" required />
                    </div>
                    <div class="lifecycle-field">
                        <label class="form-label" for="factorValidTo">有效迄日</label>
                        <input class="form-control" type="date" id="factorValidTo" name="factorValidTo" required />
                    </div>
                    <div class="lifecycle-field">
                        <label class="form-label" for="sourceDatasetVersion">來源資料集版本</label>
                        <input class="form-control" id="sourceDatasetVersion" name="sourceDatasetVersion" required />
                    </div>
                    <div class="lifecycle-field">
                        <label class="form-label" for="licenseCode">授權識別</label>
                        <input class="form-control" id="licenseCode" name="licenseCode" required />
                    </div>
                    <div class="lifecycle-field">
                        <label class="form-label" for="factorSourceName">來源機構／文件</label>
                        <input class="form-control" id="factorSourceName" name="factorSourceName" required />
                    </div>
                    <div class="lifecycle-field">
                        <label class="form-label" for="factorSourceReference">來源網址／文件編號</label>
                        <input class="form-control" id="factorSourceReference" name="factorSourceReference" required />
                    </div>
                    <div class="lifecycle-field">
                        <label class="form-label" for="datasetName">資料集名稱</label>
                        <input class="form-control" id="datasetName" name="datasetName" required />
                    </div>
                    <div class="lifecycle-field">
                        <label class="form-label" for="factorOriginalDocumentName">原始文件名稱</label>
                        <input class="form-control" id="factorOriginalDocumentName" name="factorOriginalDocumentName" required />
                    </div>
                    <div class="lifecycle-field lifecycle-field--wide">
                        <label class="form-label" for="factorOriginalDocumentSha256">原始文件 SHA-256</label>
                        <input class="form-control" id="factorOriginalDocumentSha256" name="factorOriginalDocumentSha256" pattern="[0-9a-fA-F]{64}" autocomplete="off" required />
                        <p class="workspace-select-help">請填原始下載或匯入檔案的 64 位 SHA-256。</p>
                    </div>
                    <div class="lifecycle-field lifecycle-field--wide">
                        <label class="form-label" for="factorApplicability">適用性</label>
                        <textarea class="form-control" id="factorApplicability" name="factorApplicability" required></textarea>
                    </div>
                </div>
                <button class="btn btn-outline-primary mt-2" type="submit">建立係數草稿</button>
            </form>
        </details>

        <section class="mt-4">
            <h3 class="h5">係數版本</h3>
            <label class="form-label" for="factorDatabaseSearch">查詢係數</label>
            <input class="form-control mb-3" id="factorDatabaseSearch" type="search" placeholder="輸入名稱、單位、來源或版本" data-factor-list-filter />
            <ul class="workspace-records" data-factor-list>
                @foreach (var factor in Model.Factors)
                {
                    var publicationStatus = factor.PublicationStatus switch
                    {
                        "Draft" => "草稿",
                        "Published" => "已發布",
                        "Withdrawn" => "已撤回",
                        _ => "其他狀態"
                    };
                    var geography = factor.Geography switch
                    {
                        "TW" => "台灣",
                        "Global" => "全球",
                        "East Asia" => "東亞",
                        "EU" => "歐盟",
                        "US" => "美國",
                        "CN" => "中國",
                        "JP" => "日本",
                        _ => factor.Geography
                    };
                    <li data-factor-list-item>
                        <strong>@factor.Name</strong>
                        <span>@factor.Value kgCO2e／@factor.DenominatorUnitCode／@factor.SourceDatasetVersion／@publicationStatus</span>
                        <span>來源：@factor.SourceName／@geography／@factor.SourceReference</span>
                        @if (factor.PublicationStatus == FactorPublicationStatus.Draft.ToString())
                        {
                            <form class="d-inline" method="post" asp-page="/Workspace" asp-page-handler="ReviewFactor" asp-route-section="factors">
                                <input type="hidden" name="factorVersionId" value="@factor.Id" />
                                <button class="btn btn-sm btn-outline-primary" type="submit">完成審查</button>
                            </form>
                            <form class="d-inline" method="post" asp-page="/Workspace" asp-page-handler="PublishFactor" asp-route-section="factors">
                                <input type="hidden" name="factorVersionId" value="@factor.Id" />
                                <button class="btn btn-sm btn-success" type="submit">發布</button>
                            </form>
                        }
                        else if (factor.PublicationStatus == FactorPublicationStatus.Published.ToString())
                        {
                            <form class="factor-update-form mt-2" method="post" asp-page="/Workspace" asp-page-handler="SupersedeFactor" asp-route-section="factors">
                                <input type="hidden" name="factorVersionId" value="@factor.Id" />
                                <label class="form-label" for="new-value-@factor.Id">更新係數值</label>
                                <input class="form-control" id="new-value-@factor.Id" name="newFactorValue" type="number" min="0" step="any" value="@factor.Value" required />
                                <label class="form-label mt-2" for="new-version-@factor.Id">新來源版本</label>
                                <input class="form-control" id="new-version-@factor.Id" name="newSourceDatasetVersion" required />
                                <label class="form-label mt-2" for="new-source-reference-@factor.Id">新來源網址／文件編號</label>
                                <input class="form-control" id="new-source-reference-@factor.Id" name="newFactorSourceReference" value="@factor.SourceReference" required />
                                <label class="form-label mt-2" for="new-document-name-@factor.Id">新原始文件名稱</label>
                                <input class="form-control" id="new-document-name-@factor.Id" name="newOriginalDocumentName" required />
                                <label class="form-label mt-2" for="new-document-sha-@factor.Id">新原始文件 SHA-256</label>
                                <input class="form-control"
                                       id="new-document-sha-@factor.Id"
                                       name="newOriginalDocumentSha256"
                                       pattern="[0-9a-fA-F]{64}"
                                       autocomplete="off"
                                       required />
                                <label class="form-label mt-2" for="new-applicability-@factor.Id">新版本適用性</label>
                                <textarea class="form-control" id="new-applicability-@factor.Id" name="newApplicability" required>@factor.Applicability</textarea>
                                <button class="btn btn-sm btn-outline-primary mt-2" type="submit">建立更新草稿</button>
                            </form>
                        }
                    </li>
                }
            </ul>
        </section>
    </div>
</section>
