@page
@model CarbonFootprint.Web.Pages.ReportsModel
@{
    ViewData["Title"] = "稽核匯出";
}

<h1>稽核匯出</h1>
<p>所有匯出都以不可變計算版本為基準，並寫入稽核事件。</p>

@if (Model.Runs.Count == 0)
{
    <p>目前沒有可匯出的計算版本。</p>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr><th>計算版本</th><th>建立時間</th><th>總量</th><th>PCR 報告規則</th><th>輸入資料 SHA-256</th><th>匯出</th></tr>
            </thead>
            <tbody>
                @foreach (var run in Model.Runs)
                {
                    var pcr = Model.PcrRulesByRunId.GetValueOrDefault(run.Id);
                    var roundingDecimalPlaces = Math.Clamp(pcr?.RoundingDecimalPlaces ?? 3, 0, 12);
                    <tr>
                        <td><code>@run.Id</code></td>
                        <td>@run.CreatedAt</td>
                        <td>@run.ProductTotal.ToString($"F{roundingDecimalPlaces}") kgCO2e</td>
                        <td>
                            截斷 @((pcr?.CutoffThresholdPercent ?? 0m))%；
                            小數 @roundingDecimalPlaces 位；
                            @(pcr?.ReportingRequirements ?? "未保存額外報告要求")
                        </td>
                        <td><code>@run.InputSha256</code></td>
                        <td>
                            <form class="d-inline" method="post" asp-page-handler="InventoryCsv">
                                <input type="hidden" name="runId" value="@run.Id" />
                                <button class="btn btn-sm btn-primary" type="submit">盤查清冊 CSV</button>
                            </form>
                            <form class="d-inline" method="post" asp-page-handler="EvidenceIndexCsv">
                                <input type="hidden" name="runId" value="@run.Id" />
                                <button class="btn btn-sm btn-outline-primary" type="submit">佐證索引 CSV</button>
                            </form>
                            <form class="d-inline" method="post" asp-page-handler="Manifest">
                                <input type="hidden" name="runId" value="@run.Id" />
                                <button class="btn btn-sm btn-outline-secondary" type="submit">標準輸入清單</button>
                            </form>
                            <a class="btn btn-sm btn-outline-dark" asp-page="/ArchiveReport" asp-route-runId="@run.Id">可歸檔網頁報告</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
