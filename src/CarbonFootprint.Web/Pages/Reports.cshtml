@page
@model CarbonFootprint.Web.Pages.ReportsModel
@{
    ViewData["Title"] = "稽核匯出";
}

<header class="workspace-hero"><p class="workspace-eyebrow">計算結果 / 歷史版本</p><h1>計算與稽核匯出</h1><p>選擇一次計算，下載清冊、佐證索引或可歸檔報告。</p></header>

@if (Model.Runs.Count == 0)
{
    <section class="card"><div class="card-body"><h2 class="h5">還沒有計算結果</h2><p>完成盤查與活動數據後，建立第一個計算快照。</p><a class="btn btn-primary" asp-page="/Workspace" asp-route-section="calculation">前往計算</a></div></section>
}
else
{
    @if (!Model.CanExport)
    {
        <p class="alert alert-info">匯出需要檢視權限及雙因素驗證。<a asp-area="Identity" asp-page="/Account/Manage/TwoFactorAuthentication">設定雙因素驗證</a></p>
    }
    @if (Model.InvalidRunIds.Count > 0)
    {
        <p class="alert alert-danger" role="alert">@Model.InvalidRunIds.Count 筆計算快照無法驗證，已停用其匯出。請由管理者從可信備份或原始雜湊驗證後還原；其他有效版本仍可使用。</p>
    }
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr><th scope="col">計算版本</th><th scope="col">建立時間</th><th scope="col">排放總量</th><th scope="col">報告規則</th><th scope="col">匯出</th></tr>
            </thead>
            <tbody>
                @foreach (var run in Model.Runs)
                {
                    var isValid = !Model.InvalidRunIds.Contains(run.Id);
                    var pcr = Model.PcrRulesByRunId.GetValueOrDefault(run.Id);
                    var roundingDecimalPlaces = Math.Clamp(pcr?.RoundingDecimalPlaces ?? 3, 0, 12);
                    <tr>
                        <td><strong>計算 @run.Id.ToString("N")[..8]</strong><details class="technical-details"><summary>版本與雜湊</summary><p>計算 ID：<code>@run.Id</code></p><p>SHA-256：<code>@run.InputSha256</code></p></details><a asp-page="/Workspace" asp-route-section="calculation" asp-route-projectVersionId="@run.ProjectVersionId">開啟所屬盤查</a></td>
                        <td class="numeric"><time datetime="@run.CreatedAt.ToString("O")">@run.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")<br />@run.CreatedAt.ToLocalTime().ToString("HH:mm")</time></td>
                        <td class="numeric">@(isValid ? $"{run.ProductTotal.ToString($"F{roundingDecimalPlaces}")} kgCO2e" : "尚未驗證")</td>
                        <td>
                            @if (isValid && pcr is not null)
                            {
                                <span>截斷 @pcr.CutoffThresholdPercent%；小數 @roundingDecimalPlaces 位</span>
                                <p>@pcr.ReportingRequirements</p>
                            }
                            else
                            {
                                <span class="text-danger">快照雜湊或格式無法驗證</span>
                            }
                        </td>
                        <td><fieldset class="report-downloads" disabled="@(!isValid || !Model.CanExport)">
                            <form class="d-inline" method="post" data-download asp-page-handler="InventoryCsv">
                                <input type="hidden" name="runId" value="@run.Id" />
                                <button class="btn btn-sm btn-primary" type="submit">盤查清冊 CSV</button>
                            </form>
                            <form class="d-inline" method="post" data-download asp-page-handler="EvidenceIndexCsv">
                                <input type="hidden" name="runId" value="@run.Id" />
                                <button class="btn btn-sm btn-outline-primary" type="submit">佐證索引 CSV</button>
                            </form>
                            <form class="d-inline" method="post" data-download asp-page-handler="Manifest">
                                <input type="hidden" name="runId" value="@run.Id" />
                                <button class="btn btn-sm btn-outline-secondary" type="submit">標準輸入清單</button>
                            </form>
                            @if (isValid && Model.CanExport)
                            {
                                <a class="btn btn-sm btn-outline-dark" asp-page="/Workspace" asp-page-handler="ExportExcel" asp-route-section="calculation" asp-route-projectVersionId="@run.ProjectVersionId" asp-route-runId="@run.Id">此版本 Excel</a>
                                <a class="btn btn-sm btn-outline-dark" asp-page="/ArchiveReport" asp-route-runId="@run.Id">可歸檔網頁報告</a>
                            }
                        </fieldset></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
