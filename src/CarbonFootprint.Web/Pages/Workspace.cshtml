<fieldset disabled="@(!(Model.CanManageFactors && Model.HasVerifiedMfa))">
                                        <input type="hidden" name="pcrVersionId" value="@pcr.Id" />
                                        <button class="btn btn-sm btn-outline-primary" type="submit">核准審查</button>

</fieldset></form>
                                    <form class="d-inline" method="post" asp-page-handler="RejectPcr" preserve-input-for="RejectPcr-@pcr.Id" asp-route-projectVersionId="@Model.ProjectVersionId">
<fieldset disabled="@(!(Model.CanManageFactors && Model.HasVerifiedMfa))">
                                        <input type="hidden" name="pcrVersionId" value="@pcr.Id" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit">拒絕審查</button>

</fieldset></form>
                                    <form class="d-inline" method="post" asp-page-handler="PublishPcr" preserve-input-for="PublishPcr-@pcr.Id" asp-route-projectVersionId="@Model.ProjectVersionId">
<fieldset disabled="@(!(Model.CanManageFactors))">
                                        <input type="hidden" name="pcrVersionId" value="@pcr.Id" />
                                        <button class="btn btn-sm btn-success" type="submit">發布</button>

</fieldset></form>
