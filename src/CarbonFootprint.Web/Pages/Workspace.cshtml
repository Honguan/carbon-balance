            <section class="card h-100 workspace-card" id="lifecycle">
                <div class="card-body">
                    <div class="workspace-card-heading">
                        <span class="workspace-step">06</span>
                        <div>
                            <h2 class="h4">五階段活動數據</h2>
                            <p>每個生命週期階段使用獨立頁面，逐筆記錄活動量、換算單位、係數與資料品質。</p>
                        </div>
                    </div>
                    @if (selectedPcr?.FormulaRuleSetVersion != ActivityEmissionFormula.PcrFormulaRuleSetV1)
                    {
                        <p class="alert alert-warning">階段計算公式尚待適用 PCR 與領域審核者確認；完成確認前不可正式提交。</p>
                    }
                    @if (Model.InventoryProjects.Count > 0)
                    {
                    <nav class="lifecycle-section-nav" aria-label="五階段分頁">
                        @foreach (var stageSection in lifecycleSections)
                        {
                            <a data-workspace-nav asp-page="/Workspace"
                               asp-route-section="lifecycle"
                               asp-route-stage="@stageSection.Slug"
                               asp-route-projectVersionId="@Model.ProjectVersionId"
                               aria-current="@(Model.Stage == stageSection.Slug ? "page" : null)">
                                <span>@stageSection.Number</span>@FormalStageName(stageSection.Stage)
                            </a>
                        }
                    </nav>

                    <div class="lifecycle-input-list">
                        @foreach (var stageSection in activeLifecycleSections)
                        {
                            var stageActivities = Model.Activities.Where(item => item.InventoryProjectVersionId == Model.ProjectVersionId && item.LifecycleStage == (int)stageSection.Stage).ToArray();
                            var stageHasMissingFactor = stageActivities.Any(activity => !factorsById.ContainsKey(activity.FactorVersionId));
                            var stageEmissions = stageHasMissingFactor
                                ? (decimal?)null
                                : stageActivities.Sum(activity => ActivityEmissionFormula.Calculate(
                                    activity.CanonicalValue,
                                    factorsById[activity.FactorVersionId].Value,
                                    activity.AllocationFactor));
                            <section class="lifecycle-input-section" id="@stageSection.Slug">
                                <header>
                                    <span>@stageSection.Number</span>
                                    <div>
                                        <h3>@FormalStageName(stageSection.Stage)</h3>
                                        <p>@stageSection.Summary</p>
                                    </div>
                                    <strong>@stageActivities.Length 筆／@(stageEmissions.HasValue ? $"{DisplayAmount(stageEmissions.Value)} kgCO2e" : "係數版本遺失")</strong>
                                </header>
                                <div class="lifecycle-formula-note">
                                    <strong>階段計算方式</strong>
                                    <span>@stageSection.Formula</span>
                                    <span>系統先依受控單位目錄換算，再逐筆執行「活動量 × 係數 × 分配比例」。</span>
                                </div>
                                @if (!Model.CanEditInventory)
                                {
                                    <p class="alert alert-secondary">目前為唯讀：需要編輯權限，且盤查須為草稿或退回補正狀態。</p>
                                }
