@page "{section?}/{stage?}"
@model CarbonFootprint.Web.Pages.WorkspaceModel
@using CarbonFootprint.Domain.Modules.Calculations
@using CarbonFootprint.Domain.Modules.Factors
@using CarbonFootprint.Domain.Modules.Inventories
@using CarbonFootprint.Domain.Modules.Standards
@{
    ViewData["Title"] = "盤查工作區";
    var isSetupSection = Model.Section is "setup" or "product" or "pcr" or "inventory";
    var latestSelectedRun = Model.Runs.FirstOrDefault(item => item.ProjectVersionId == Model.ProjectVersionId);
    var selectedInventory = Model.InventoryProjects.FirstOrDefault(item => item.Id == Model.ProjectVersionId);
    var selectedPcr = selectedInventory?.PcrVersionId is { } selectedPcrId
        ? Model.PcrVersions.FirstOrDefault(item => item.Id == selectedPcrId)
        : null;
    string FormatReportingDecimal(decimal value) =>
        value.ToString(Model.LatestReportingRules is { } rules ? $"F{rules.RoundingDecimalPlaces}" : "G29");
    string DisplayAmount(decimal value) => value.ToString("0.############################");
    var factorsById = Model.Factors.ToDictionary(item => item.Id);
    var hasFacilities = Model.Facilities.Count > 0;
    var hasProductVersions = Model.ProductVersions.Count > 0;
    var hasSelectablePcrVersions = Model.SelectablePcrVersions.Count > 0;
    var hasSelectableFactors = Model.SelectableFactors.Count > 0;
    var canCreateInventory = hasProductVersions && hasSelectablePcrVersions;
    string PublicationStatusName(string status) => status switch
    {
        "Draft" => "草稿",
        "Published" => "已發布",
        "Withdrawn" => "已撤回",
        _ => "其他狀態"
    };
    string WorkflowStatusName(InventoryWorkflowStatus status) => status switch
    {
        InventoryWorkflowStatus.Draft => "草稿",
        InventoryWorkflowStatus.Submitted => "已提交",
        InventoryWorkflowStatus.ChangesRequested => "退回補正",
        InventoryWorkflowStatus.Approved => "已核准",
        _ => "其他狀態"
    };
    string FormalStageName(LifecycleStage stage) => stage switch
    {
        LifecycleStage.RawMaterial => "原料取得階段",
        LifecycleStage.Manufacturing => "製造階段",
        LifecycleStage.Distribution => "配送與銷售階段",
        LifecycleStage.Use => "使用階段",
        LifecycleStage.EndOfLife => "廢棄處理階段",
        _ => "未定義階段"
    };
    string ActivityKindName(ActivityDataKind kind) => kind switch
    {
        ActivityDataKind.Material => "原物料投入",
        ActivityDataKind.MaterialTransport => "原物料運輸",
        ActivityDataKind.Energy => "能資源使用",
        ActivityDataKind.ManufacturingWaste => "製造廢棄物",
        ActivityDataKind.OutsourcedTreatmentTransport => "委外處理運輸",
        ActivityDataKind.DistributionTransport => "配送銷售運輸",
        ActivityDataKind.UseEnergy => "使用能源",
        ActivityDataKind.UseConsumable => "使用耗材",
        ActivityDataKind.EndOfLifeTreatment => "廢棄處理",
        ActivityDataKind.EndOfLifeTransport => "廢棄處理運輸",
        _ => "其他活動"
    };
    string ScanStatusName(string status) => status switch
    {
        "Pending" => "掃描中",
        "Clean" => "掃描通過",
        "Rejected" => "已拒絕",
        "Failed" => "掃描失敗",
        _ => "其他狀態"
    };
    string RoleName(string role) => role switch
    {
        "Owner" => "擁有者",
        "Administrator" => "管理者",
        "Contributor" => "編輯者",
        "Reviewer" => "審查者",
        "Viewer" => "檢視者",
        _ => "其他角色"
    };
    string FormulaName(string formulaId) => formulaId switch
    {
        ActivityAmountFormula.DirectFormulaId => "直接活動量",
        ActivityAmountFormula.TransportFormulaId => "距離乘重量換算",
        ActivityAmountFormula.UseScenarioFormulaId => "使用情境消耗量",
        "material-input-times-factor-times-allocation-v1" => "原物料投入乘係數與分配",
        "material-transport-work-times-factor-times-allocation-v1" => "原物料運輸乘係數與分配",
        "manufacturing-consumption-times-factor-times-allocation-v1" => "製造消耗乘係數與分配",
        "manufacturing-waste-times-factor-times-allocation-v1" => "製造廢棄物乘係數與分配",
        "outsourced-transport-work-times-factor-times-allocation-v1" => "委外運輸乘係數與分配",
        "distribution-transport-work-times-factor-times-allocation-v1" => "配送運輸乘係數與分配",
        "use-energy-consumption-times-factor-times-allocation-v1" => "使用能源乘係數與分配",
        "use-consumable-times-factor-times-allocation-v1" => "使用耗材乘係數與分配",
        "end-of-life-treatment-times-factor-times-allocation-v1" => "廢棄處理乘係數與分配",
        "end-of-life-transport-work-times-factor-times-allocation-v1" => "廢棄運輸乘係數與分配",
        _ => "未識別公式"
    };
    var lifecycleSections = new[]
    {
        new { Stage = LifecycleStage.RawMaterial, Number = "01", Slug = "raw-material", Title = "原料取得階段", Summary = "原物料投入與供應商運輸", Formula = "原料投入量 × 對應係數；原料運輸以重量 × 距離換算重量距離後 × 運輸係數。", ActivityLabel = "原物料名稱／運輸項目", ScenarioLabel = "材質／供應商名稱與地址", ValueLabel = "投入量／重量距離活動量", Kinds = new[] { ActivityDataKind.Material, ActivityDataKind.MaterialTransport } },
        new { Stage = LifecycleStage.Manufacturing, Number = "02", Slug = "manufacturing", Title = "製造階段", Summary = "能資源、製造廢棄與委外運輸", Formula = "每一種能資源消耗分筆乘係數；廢棄量先換算係數分母單位，委外運輸以重量距離乘係數。", ActivityLabel = "能資源／廢棄物名稱", ScenarioLabel = "製程／處理廠與運輸說明", ValueLabel = "消耗量／廢棄量／重量距離", Kinds = new[] { ActivityDataKind.Energy, ActivityDataKind.ManufacturingWaste, ActivityDataKind.OutsourcedTreatmentTransport } },
        new { Stage = LifecycleStage.Distribution, Number = "03", Slug = "distribution", Title = "配送與銷售階段", Summary = "配銷據點與銷售運輸", Formula = "單趟距離 × 單位產品重量 ÷ 1000 得到 tkm，再乘該運具排放係數。", ActivityLabel = "配銷據點／運輸項目", ScenarioLabel = "據點地址／運輸工具與重量距離來源", ValueLabel = "重量距離活動量（建議 tkm）", Kinds = new[] { ActivityDataKind.DistributionTransport } },
        new { Stage = LifecycleStage.Use, Number = "04", Slug = "use", Title = "使用階段", Summary = "使用壽命、頻率、能源與耗材", Formula = "每個能源或耗材的情境消耗量分別乘對應係數；多個消耗項目逐筆加總。", ActivityLabel = "使用情境／消耗項目", ScenarioLabel = "壽命、頻率與消耗量公式說明", ValueLabel = "該消耗項目的公式結果", Kinds = new[] { ActivityDataKind.UseEnergy, ActivityDataKind.UseConsumable } },
        new { Stage = LifecycleStage.EndOfLife, Number = "05", Slug = "end-of-life", Title = "廢棄處理階段", Summary = "回收、焚化、掩埋與處理運輸", Formula = "廢棄量依單位目錄換算（kg ÷ 1000 → tonne）後乘處理係數；運輸另以 tkm 乘係數。", ActivityLabel = "處理方式／運輸項目", ScenarioLabel = "處理廠／服務與運輸情境", ValueLabel = "廢棄量／重量距離活動量", Kinds = new[] { ActivityDataKind.EndOfLifeTreatment, ActivityDataKind.EndOfLifeTransport } }
    };
    string InventoryLabel(CarbonFootprint.Infrastructure.Persistence.InventoryProjectVersionRecord inventory) =>
        $"{Model.ProductVersions.FirstOrDefault(item => item.Id == inventory.ProductVersionId)?.NameZhTw ?? "產品"} · 第 {inventory.VersionNumber} 版 · {inventory.PeriodStart:yyyy-MM-dd}～{inventory.PeriodEnd:yyyy-MM-dd}";
    var activeLifecycleSections = lifecycleSections.Where(item => item.Slug == Model.Stage).ToArray();
}
<header class="workspace-hero">
    <p class="workspace-eyebrow">產品碳足跡 / 盤查與管理</p>
    <h1>盤查工作區</h1>
    <p>建立資料、記錄五階段活動，保存每次計算與審查軌跡。</p>
</header>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}
<div asp-validation-summary="All" class="text-danger" role="alert"></div>

@if (!Model.OrganizationId.HasValue)
{
    <section class="card mb-4">
        <div class="card-body">
            <h2 class="h4">1. 建立組織</h2>
            <form method="post" asp-page-handler="CreateOrganization" preserve-input-for="CreateOrganization" asp-route-projectVersionId="@Model.ProjectVersionId">
                <label class="form-label" for="organizationName">組織名稱</label>
                <input class="form-control" id="organizationName" name="organizationName" required maxlength="200" />
                <button class="btn btn-primary mt-3" type="submit">建立組織</button>
            </form>
        </div>
    </section>
}
else
{
    <section class="workspace-context" aria-label="目前作業範圍">
        <div><span>目前組織</span><strong>@Model.OrganizationName</strong>
            @if (Model.CanManageOrganization)
            {
                <a class="workspace-context-settings" asp-page="/Workspace" asp-route-section="settings" asp-route-stage="mail" asp-route-projectVersionId="@Model.ProjectVersionId">郵件設定</a>
            }
        </div>
        @if (Model.InventoryProjects.Count > 0)
        {
            <form method="get" asp-page="/Workspace" asp-route-section="@Model.Section" asp-route-stage="@Model.Stage" class="workspace-project-picker">
                <label class="form-label" for="projectVersionId">目前盤查版本</label>
                <select class="form-select" id="projectVersionId" name="projectVersionId" data-auto-submit-select>
                    @foreach (var inventory in Model.InventoryProjects)
                    {
                        <option value="@inventory.Id" selected="@(inventory.Id == Model.ProjectVersionId)">@InventoryLabel(inventory)</option>
                    }
                </select>
                <button class="btn btn-outline-primary" type="submit">切換</button>
            </form>
        }
        @if (selectedInventory is not null)
        {
            <span class="workspace-status-badge">@WorkflowStatusName(Enum.Parse<InventoryWorkflowStatus>(selectedInventory.WorkflowStatus))</span>
        }
    </section>

    <nav class="workspace-stage-nav" aria-label="盤查作業分頁">
        <a asp-page="/Workspace" asp-route-section="governance" aria-current="@(Model.Section == "governance" ? "page" : null)" asp-route-projectVersionId="@Model.ProjectVersionId"><span>01</span>組織與廠場</a>
        <a asp-page="/Workspace" asp-route-section="product" aria-current="@(Model.Section == "product" ? "page" : null)" asp-route-projectVersionId="@Model.ProjectVersionId"><span>02</span>產品資料</a>
        <a asp-page="/Workspace" asp-route-section="pcr" aria-current="@(Model.Section == "pcr" ? "page" : null)" asp-route-projectVersionId="@Model.ProjectVersionId"><span>03</span>PCR 規範</a>
        <a asp-page="/Workspace" asp-route-section="inventory" aria-current="@(Model.Section is "inventory" or "setup" ? "page" : null)" asp-route-projectVersionId="@Model.ProjectVersionId"><span>04</span>盤查範圍</a>
        <a asp-page="/Workspace" asp-route-section="factors" aria-current="@(Model.Section == "factors" ? "page" : null)" asp-route-projectVersionId="@Model.ProjectVersionId"><span>05</span>係數資料庫</a>
        <a asp-page="/Workspace" asp-route-section="lifecycle" asp-route-stage="raw-material" aria-current="@(Model.Section == "lifecycle" ? "page" : null)" asp-route-projectVersionId="@Model.ProjectVersionId"><span>06</span>五階段活動</a>
        <a asp-page="/Workspace" asp-route-section="calculation" aria-current="@(Model.Section == "calculation" ? "page" : null)" asp-route-projectVersionId="@Model.ProjectVersionId"><span>07</span>計算與結果</a>
    </nav>
    @if (!string.IsNullOrWhiteSpace(selectedInventory?.ReviewComment))
    {
        <aside class="alert alert-warning" aria-label="盤查審查意見">
            <strong>審查意見</strong> <time>@selectedInventory.ReviewedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</time>
            <p class="mb-0 review-comment">@selectedInventory.ReviewComment</p>
        </aside>
    }

    @if (!Model.HasVerifiedMfa)
    {
        <p class="alert alert-info">計算、提交與管理審查作業需要雙因素驗證。<a asp-area="Identity" asp-page="/Account/Manage/TwoFactorAuthentication">設定雙因素驗證</a></p>
    }
    <div id="workspace-content" data-workspace-content>
    @if (Model.Section == "settings" && Model.Stage == "mail")
    {
        <partial name="_MailSettings" model="Model" />
    }
    @if (Model.Section == "governance")
    {
    <section class="card mb-4 workspace-card" id="governance">
        <div class="card-body">
            <div class="workspace-card-heading">
                <span class="workspace-step">01</span>
                <div>
                    <h2 class="h4">組織、成員與廠場</h2>
                    <p>先確認盤查資料的歸屬組織、作業廠場與協作權限。</p>
                </div>
            </div>
            <div class="row g-3">
                <form class="col-lg-4 workspace-subpanel" method="post" asp-page-handler="CreateFacility" preserve-input-for="CreateFacility" asp-route-projectVersionId="@Model.ProjectVersionId">
<fieldset disabled="@(!(Model.CanManageOrganization))">
                    <h3 class="h6">廠場基本資料</h3>
                    <label class="form-label" for="facilityCode">廠場代碼</label>
                    <input class="form-control" id="facilityCode" name="facilityCode" required maxlength="100" />
                    <label class="form-label mt-2" for="facilityName">廠場名稱</label>
                    <input class="form-control" id="facilityName" name="facilityName" required maxlength="300" />
                    <button class="btn btn-primary mt-2" type="submit">建立廠場</button>

</fieldset></form>
                <form class="col-lg-4 workspace-subpanel" method="post" asp-page-handler="InviteMember" preserve-input-for="InviteMember" asp-route-projectVersionId="@Model.ProjectVersionId">
<fieldset disabled="@(!(Model.CanManageOrganization && Model.HasVerifiedMfa))">
                    <h3 class="h6">新增協作成員</h3>
                    <label class="form-label" for="invitationEmail">受邀電子郵件</label>
                    <input class="form-control" id="invitationEmail" name="invitationEmail" type="email" required maxlength="320" />
                    <label class="form-label mt-2" for="invitationRole">角色</label>
                    <select class="form-select" id="invitationRole" name="invitationRole">
                        @foreach (var role in Enum.GetValues<CarbonFootprint.Domain.Modules.Organizations.OrganizationRole>().Where(role => role != CarbonFootprint.Domain.Modules.Organizations.OrganizationRole.Owner))
                        {
                            <option value="@role">@RoleName(role.ToString())</option>
                        }
                    </select>
                    <button class="btn btn-primary mt-2" type="submit">寄送邀請</button>

</fieldset></form>
                <div class="col-lg-4 workspace-subpanel">
                    <h3 class="h6">現有成員與角色</h3>
                    <ul>
                        @foreach (var membership in Model.Memberships)
                        {
                            <li>
                                @Model.MemberNames.GetValueOrDefault(membership.UserId, "未命名成員")：@RoleName(membership.Role)
                                @if (membership.RevokedAt is null && membership.Role != CarbonFootprint.Domain.Modules.Organizations.OrganizationRole.Owner.ToString())
                                {
                                    <form class="d-inline" method="post" asp-page-handler="RevokeMember" preserve-input-for="RevokeMember-@membership.Id" asp-route-projectVersionId="@Model.ProjectVersionId">
<fieldset disabled="@(!(Model.CanManageOrganization && Model.HasVerifiedMfa))">
                                        <input type="hidden" name="membershipId" value="@membership.Id" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit">撤銷</button>

</fieldset></form>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </div>
            <h3 class="h6 mt-4">待處理邀請</h3>
            <ul>
                @foreach (var invitation in Model.Invitations.Where(item => item.AcceptedAt is null && item.RevokedAt is null))
                {
                    <li>
                        @invitation.Email：@RoleName(invitation.Role)（到期 @invitation.ExpiresAt.ToString("u")）
                        <form class="d-inline" method="post" asp-page-handler="RevokeInvitation" preserve-input-for="RevokeInvitation-@invitation.Id" asp-route-projectVersionId="@Model.ProjectVersionId">
<fieldset disabled="@(!(Model.CanManageOrganization && Model.HasVerifiedMfa))">
                            <input type="hidden" name="invitationId" value="@invitation.Id" />
                            <button class="btn btn-sm btn-outline-danger" type="submit">撤銷邀請</button>

</fieldset></form>
                    </li>
                }
            </ul>
        </div>
    </section>
    }

    <div class="row g-4">
        @if (isSetupSection)
        {
        <div class="col-12">
            <section class="workspace-setup-shell" aria-labelledby="setup-heading">
                <div class="workspace-group-heading">
                    <span>02–04</span>
                    <div>
                        <h2 id="setup-heading">產品基本資料與盤查設定</h2>
                        <p>依序建立產品、保存 PCR 規範，再設定盤查範圍；三個區塊各自儲存。</p>
                    </div>
                </div>
                <div class="row g-4">
                @if (Model.Section is "setup" or "product")
                {
                <div class="col-12">
            <section class="card h-100 workspace-card" id="product">
                <div class="card-body">
                    <div class="workspace-card-heading">
                        <span class="workspace-step">02</span>
                        <div>
                            <h2 class="h4">產品基本資料</h2>
                            <p>建立盤查對象、分類與生產廠場的版本關係。</p>
                        </div>
                    </div>
                    <form method="post" asp-page-handler="CreateProduct" preserve-input-for="CreateProduct" asp-route-projectVersionId="@Model.ProjectVersionId">
<fieldset disabled="@(!(Model.CanEditData))">
                        <h3 class="workspace-subheading">產品識別</h3>
                        <label class="form-label" for="productName">產品名稱</label>
                        <input class="form-control" id="productName" name="productName" required maxlength="300" />
                        <label class="form-label mt-2" for="categoryCode">產品分類代碼</label>
                        <input class="form-control" id="categoryCode" name="categoryCode" required maxlength="100" />
                        <div class="workspace-select-field">
                            <label class="form-label mt-2" for="facilityId">所屬廠場</label>
                            <select class="form-select" id="facilityId" name="facilityId" required disabled="@(!hasFacilities)" aria-describedby="facilityId-help">
                                <option value="">@(hasFacilities ? "請選擇所屬廠場" : "尚無可選廠場")</option>
                                @foreach (var facility in Model.Facilities)
                                {
                                    <option value="@facility.Id">@facility.Code - @facility.Name</option>
                                }
                            </select>
                            <p class="workspace-select-help" id="facilityId-help">
                                @if (hasFacilities)
                                {
                                    <span>選擇此產品實際生產或管理的廠場。</span>
                                }
                                else
                                {
                                    <span>目前沒有廠場。請先到 <a asp-page="/Workspace" asp-route-section="governance" asp-route-projectVersionId="@Model.ProjectVersionId">組織與廠場</a> 建立廠場。</span>
                                }
                            </p>
                        </div>
                        <button class="btn btn-primary mt-3" type="submit" disabled="@(!hasFacilities)">儲存產品第 1 版</button>

</fieldset></form>
                    <h3 class="workspace-subheading mt-4">已建立版本</h3>
                    <ul class="workspace-records">
                        @foreach (var item in Model.ProductVersions)
                        {
                            <li>@item.NameZhTw（第 @(item.VersionNumber) 版）</li>
                        }
                    </ul>
                </div>
            </section>
        </div>
                }

                @if (Model.Section is "setup" or "pcr")
                {
        <div class="col-12">
            <section class="card h-100 workspace-card" id="pcr">
                <div class="card-body">
                    <div class="workspace-card-heading">
                        <span class="workspace-step">03</span>
                        <div>
                            <h2 class="h4">PCR 規範版本</h2>
                            <p>分別記錄規範識別、有效期間、適用範圍與原始文件完整性。</p>
                        </div>
                    </div>
                    <form method="post" asp-page-handler="CreatePcr" enctype="multipart/form-data" preserve-input-for="CreatePcr" asp-route-projectVersionId="@Model.ProjectVersionId">
<fieldset disabled="@(!(Model.CanManageFactors))">
                        <h3 class="workspace-subheading">規範識別與有效期間</h3>
                        <label class="form-label" for="registrationNumber">登錄編號</label>
                        <input class="form-control" id="registrationNumber" name="registrationNumber" required />
                        <label class="form-label mt-2" for="pcrTitle">名稱</label>
                        <input class="form-control" id="pcrTitle" name="title" required />
                        <label class="form-label mt-2" for="pcrVersionNumber">版本</label>
                        <input class="form-control" type="number" min="1" id="pcrVersionNumber" name="versionNumber" value="1" required />
                        <label class="form-label mt-2" for="pcrApprovalDate">核准日</label>
                        <input class="form-control" type="date" id="pcrApprovalDate" name="approvalDate" required />
                        <label class="form-label mt-2" for="pcrValidFrom">有效起日</label>
                        <input class="form-control" type="date" id="pcrValidFrom" name="validFrom" value="2025-01-01" required />
                        <label class="form-label mt-2" for="pcrValidTo">有效迄日</label>
                        <input class="form-control" type="date" id="pcrValidTo" name="validTo" value="2027-12-31" required />
                        <h3 class="workspace-subheading mt-4">標準與適用範圍</h3>
                        <label class="form-label mt-2" for="sourceReference">來源參照</label>
                        <input class="form-control" type="url" id="sourceReference" name="sourceReference" placeholder="https://主管機關或受控來源" required />
                        <label class="form-label mt-2" for="standardCode">標準代碼</label>
                        <input class="form-control" id="standardCode" name="standardCode" value="ISO 14067" required />
                        <label class="form-label mt-2" for="cccClassification">CCC 分類</label>
                        <input class="form-control" id="cccClassification" name="cccClassification" required />
                        <label class="form-label mt-2" for="pcrApplicability">適用性</label>
                        <textarea class="form-control" id="pcrApplicability" name="pcrApplicability" required></textarea>
                        <label class="form-label mt-2" for="ruleRequirements">規則要求模板</label>
