                                    <fieldset disabled="@(!Model.CanEditInventory)">
                                    @if (Model.EditingActivity is not null)
                                    {
                                        <input type="hidden" name="activityId" value="@Model.EditingActivity.Id" />
                                        <div class="alert alert-info">正在更正「@Model.EditingActivity.Name」。儲存後保留舊活動與歷史計算，新活動請重新附上佐證。</div>
                                    }
                                    <input type="hidden" name="lifecycleStage" value="@stageSection.Stage" />
                                    <input type="hidden" name="inventoryProjectVersionId" value="@Model.ProjectVersionId" />
                                    <div class="lifecycle-form-grid">
                                        <div class="lifecycle-field">
                                            <label class="form-label" for="kind-@stageSection.Slug">活動類型</label>
                                            <select class="form-select" id="kind-@stageSection.Slug" name="activityKind" required>
                                                @foreach (var kind in stageSection.Kinds)
                                                {
                                                    var formulaKind = ActivityAmountFormula.IsTransport(kind)
                                                        ? "transport"
                                                        : ActivityAmountFormula.IsUseScenario(kind) ? "use" : "direct";
                                                    <option value="@kind" data-formula-kind="@formulaKind">@ActivityKindName(kind)</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="lifecycle-field">
                                            <label class="form-label" for="activity-@stageSection.Slug">@stageSection.ActivityLabel</label>
                                            <select class="form-select" id="activity-@stageSection.Slug" name="activityName" required data-controlled-other data-other-target="#activity-other-@stageSection.Slug">
                                                @if (stageSection.Stage == LifecycleStage.RawMaterial)
                                                {
                                                    <option value="主要原物料">主要原物料</option>
                                                    <option value="包裝材料">包裝材料</option>
                                                    <option value="輔助材料">輔助材料</option>
                                                    <option value="供應商運輸">供應商運輸</option>
                                                }
                                                else if (stageSection.Stage == LifecycleStage.Manufacturing)
                                                {
                                                    <option value="市電">市電</option>
                                                    <option value="自發電力">自發電力</option>
                                                    <option value="天然氣／燃料">天然氣／燃料</option>
                                                    <option value="蒸汽">蒸汽</option>
                                                    <option value="用水">用水</option>
                                                    <option value="冷媒">冷媒</option>
                                                    <option value="製造廢棄物">製造廢棄物</option>
                                                    <option value="委外處理運輸">委外處理運輸</option>
                                                }
                                                else if (stageSection.Stage == LifecycleStage.Distribution)
                                                {
                                                    <option value="公路運輸">公路運輸</option>
                                                    <option value="鐵路運輸">鐵路運輸</option>
                                                    <option value="海運">海運</option>
                                                    <option value="空運">空運</option>
                                                }
                                                else if (stageSection.Stage == LifecycleStage.Use)
                                                {
                                                    <option value="使用電力">使用電力</option>
                                                    <option value="使用用水">使用用水</option>
                                                    <option value="使用燃料">使用燃料</option>
                                                    <option value="耗材／維護">耗材／維護</option>
                                                }
                                                else
                                                {
                                                    <option value="回收">回收</option>
                                                    <option value="焚化">焚化</option>
                                                    <option value="掩埋">掩埋</option>
                                                    <option value="廢棄物運輸">廢棄物運輸</option>
                                                }
                                                <option value="__other__">其他（自行輸入）</option>
                                            </select>
                                            <input class="form-control mt-2" id="activity-other-@stageSection.Slug" name="activityNameOther" aria-label="其他活動名稱" placeholder="請輸入其他活動項目" maxlength="300" hidden />
                                        </div>
                                        <div class="lifecycle-field lifecycle-field--wide">
                                            <label class="form-label" for="scenario-@stageSection.Slug">@stageSection.ScenarioLabel</label>
                                            <input class="form-control" id="scenario-@stageSection.Slug" name="supplierOrScenario" maxlength="1000" />
                                        </div>
                                        @if (stageSection.Stage == LifecycleStage.Manufacturing)
                                        {
                                            <div class="lifecycle-field">
                                                <label class="form-label" for="equipment-@stageSection.Slug">設備類別（選填）</label>
                                                <select class="form-select" id="equipment-@stageSection.Slug" name="equipmentCategory" data-controlled-other data-other-target="#equipment-other-@stageSection.Slug">
                                                    <option value="">不指定設備</option>
                                                    <option value="生產機台">生產機台</option>
                                                    <option value="空壓機">空壓機</option>
                                                    <option value="鍋爐">鍋爐</option>
                                                    <option value="冰水主機／冷凍設備">冰水主機／冷凍設備</option>
                                                    <option value="空調／通風">空調／通風</option>
                                                    <option value="泵浦／馬達">泵浦／馬達</option>
                                                    <option value="照明">照明</option>
                                                    <option value="__other__">其他（自行輸入）</option>
                                                </select>
                                                <input class="form-control mt-2" id="equipment-other-@stageSection.Slug" name="equipmentCategoryOther" aria-label="其他設備類別" placeholder="請輸入其他設備類別" maxlength="200" hidden />
                                                <p class="workspace-select-help">設備類別為選填；品牌、型號、功率與效率只在 PCR 或分配佐證需要時填入情境說明。</p>
                                            </div>
                                        }
                                        <div class="lifecycle-field">
                                            <label class="form-label" for="source-type-@stageSection.Slug">資料來源類型</label>
                                            <select class="form-select" id="source-type-@stageSection.Slug" name="dataSourceType" required data-controlled-other data-other-target="#source-type-other-@stageSection.Slug">
                                                <option value="一級數據－直接量測">一級數據－直接量測</option>
                                                <option value="一級數據－帳單／發票">一級數據－帳單／發票</option>
                                                <option value="一級數據－供應商提供">一級數據－供應商提供</option>
                                                <option value="二級數據－資料庫／文獻">二級數據－資料庫／文獻</option>
                                                <option value="估算／替代資料">估算／替代資料</option>
                                                <option value="__other__">其他（自行輸入）</option>
                                            </select>
                                            <input class="form-control mt-2" id="source-type-other-@stageSection.Slug" name="dataSourceTypeOther" aria-label="其他資料來源類型" placeholder="請輸入其他來源類型" maxlength="200" hidden />
                                        </div>
                                        <div class="lifecycle-field">
                                            <label class="form-label" for="provider-@stageSection.Slug">資料提供者</label>
                                            <select class="form-select" id="provider-@stageSection.Slug" name="dataProviderType" required data-controlled-other data-other-target="#provider-other-@stageSection.Slug">
                                                <option value="本組織／廠場">本組織／廠場</option>
                                                <option value="供應商">供應商</option>
                                                <option value="公用事業單位">公用事業單位</option>
                                                <option value="物流／處理業者">物流／處理業者</option>
                                                <option value="主管機關／資料庫維護者">主管機關／資料庫維護者</option>
                                                <option value="__other__">其他（自行輸入）</option>
                                            </select>
                                            <input class="form-control mt-2" id="provider-other-@stageSection.Slug" name="dataProviderOther" aria-label="其他資料提供者" placeholder="請輸入其他提供者" maxlength="300" hidden />
                                        </div>
                                        <div class="lifecycle-field">
                                            <label class="form-label" for="collection-@stageSection.Slug">取得方式</label>
                                            <select class="form-select" id="collection-@stageSection.Slug" name="collectionMethod" required data-controlled-other data-other-target="#collection-other-@stageSection.Slug">
                                                <option value="直接量測">直接量測</option>
                                                <option value="帳單／發票／出貨紀錄">帳單／發票／出貨紀錄</option>
                                                <option value="ERP／MES／管理系統匯出">ERP／MES／管理系統匯出</option>
                                                <option value="供應商聲明／問卷">供應商聲明／問卷</option>
                                                <option value="資料庫／文獻查詢">資料庫／文獻查詢</option>
                                                <option value="計算／估算">計算／估算</option>
                                                <option value="__other__">其他（自行輸入）</option>
                                            </select>
                                            <input class="form-control mt-2" id="collection-other-@stageSection.Slug" name="collectionMethodOther" aria-label="其他取得方式" placeholder="請輸入其他取得方式" maxlength="300" hidden />
                                        </div>
                                        <div class="lifecycle-field lifecycle-field--wide">
                                            <label class="form-label" for="source-reference-@stageSection.Slug">來源參照</label>
                                            <input class="form-control" id="source-reference-@stageSection.Slug" name="sourceReference" placeholder="帳單、電表、文件、資料集或供應商聲明編號" required maxlength="500" />
                                        </div>
                                        <div class="lifecycle-field" data-direct-input>
                                            <label class="form-label" for="value-@stageSection.Slug">@stageSection.ValueLabel</label>
                                            <input class="form-control" type="number" step="any" min="0" id="value-@stageSection.Slug" name="rawValue" />
                                        </div>
                                        <div class="lifecycle-field" data-transport-input hidden>
                                            <label class="form-label" for="distance-@stageSection.Slug">運輸距離（km）</label>
                                            <input class="form-control" type="number" step="any" min="0" id="distance-@stageSection.Slug" name="transportDistanceKm" />
                                        </div>
                                        <div class="lifecycle-field" data-transport-input hidden>
                                            <label class="form-label" for="weight-@stageSection.Slug">運輸重量（kg）</label>
                                            <input class="form-control" type="number" step="any" min="0" id="weight-@stageSection.Slug" name="transportWeightKg" />
                                        </div>
                                        <div class="lifecycle-field" data-use-input hidden>
                                            <label class="form-label" for="lifetime-@stageSection.Slug">使用壽命／期間數</label>
                                            <input class="form-control" type="number" step="any" min="0" id="lifetime-@stageSection.Slug" name="useLifetime" />
                                        </div>
                                        <div class="lifecycle-field" data-use-input hidden>
                                            <label class="form-label" for="frequency-@stageSection.Slug">每期間使用頻率</label>
                                            <input class="form-control" type="number" step="any" min="0" id="frequency-@stageSection.Slug" name="useFrequency" />
                                        </div>
                                        <div class="lifecycle-field" data-use-input hidden>
                                            <label class="form-label" for="consumption-@stageSection.Slug">每次能源／耗材消耗量</label>
                                            <input class="form-control" type="number" step="any" min="0" id="consumption-@stageSection.Slug" name="useConsumptionPerUse" />
                                        </div>
                                        <div class="lifecycle-field" data-unit-input>
                                            <label class="form-label" for="raw-unit-@stageSection.Slug">原始單位</label>
                                            <select class="form-select" id="raw-unit-@stageSection.Slug" name="rawUnitCode" required>
                                                @foreach (var unit in Model.Units)
                                                {
                                                    <option value="@unit.Code">@unit.Code</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="lifecycle-field" data-unit-input>
                                            <label class="form-label" for="canonical-unit-@stageSection.Slug">計算標準單位</label>
                                            <select class="form-select" id="canonical-unit-@stageSection.Slug" name="canonicalUnitCode" required>
                                                @foreach (var unit in Model.Units)
                                                {
                                                    <option value="@unit.Code">@unit.Code</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="lifecycle-field lifecycle-field--wide">
                                            <label class="form-label" for="factor-@stageSection.Slug">排放係數版本</label>
                                            <input class="form-control mb-2"
                                                   id="factor-search-@stageSection.Slug"
                                                   type="search"
                                                   placeholder="先輸入係數名稱、單位或來源查詢"
                                                   data-factor-filter />
                                            <select class="form-select" id="factor-@stageSection.Slug" name="factorVersionId" required disabled="@(!hasSelectableFactors)" aria-describedby="factor-@stageSection.Slug-help" data-factor-select>
                                                <option value="">@(hasSelectableFactors ? "請選擇已發布排放係數" : "尚無已發布排放係數")</option>
                                                @foreach (var factor in Model.SelectableFactors)
                                                {
                                                    <option value="@factor.Id"
                                                            data-factor-value="@factor.Value"
                                                            data-factor-unit="@factor.DenominatorUnitCode"
                                                            data-factor-search="@factor.Name @factor.DenominatorUnitCode @factor.SourceName @factor.SourceDatasetVersion">
                                                        @factor.Name：@factor.Value kgCO2e／@factor.DenominatorUnitCode（@factor.SourceDatasetVersion）
                                                    </option>
                                                }
                                            </select>
                                            <p class="workspace-select-help" id="factor-@stageSection.Slug-help">
                                                @if (!hasSelectableFactors)
                                                {
                                                    <span>請先到 <a asp-page="/Workspace" asp-route-section="factors" asp-route-projectVersionId="@Model.ProjectVersionId">排放係數</a> 建立、審查並發布係數版本。</span>
                                                }
                                                else
                                                {
                                                    <span>只列出已發布係數；有效期間與單位會在儲存時再次檢查。</span>
                                                }
                                            </p>
                                        </div>
                                        <div class="lifecycle-field">
                                            <label class="form-label" for="allocation-@stageSection.Slug">分配比例（0～1）</label>
                                            <input class="form-control" id="allocation-@stageSection.Slug" name="allocationFactor" type="number" min="0.000000000000001" max="1" step="any" value="1" required />
                                        </div>
                                        <div class="lifecycle-field">
                                            <label class="form-label" for="quality-@stageSection.Slug">資料品質</label>
                                            <select class="form-select" id="quality-@stageSection.Slug" name="dataQuality" required>
                                                <option value="primary">一級數據</option>
                                                <option value="secondary-reviewed">經審查二級數據</option>
                                                <option value="estimated">估算數據</option>
                                            </select>
                                        </div>
                                        <div class="lifecycle-field lifecycle-field--wide">
                                            <div class="form-check">
                                                <input class="form-check-input" id="estimated-@stageSection.Slug" name="isEstimated" type="checkbox" value="true" />
                                                <label class="form-check-label" for="estimated-@stageSection.Slug">此筆為估算或替代資料</label>
                                            </div>
                                            <label class="form-label mt-2" for="reason-@stageSection.Slug">估算／替代資料理由</label>
                                            <textarea class="form-control" id="reason-@stageSection.Slug" name="activityEstimationReason" maxlength="4000"></textarea>
                                        </div>
                                        <div class="lifecycle-field lifecycle-field--wide lifecycle-formula-preview">
                                            <strong>本筆係數計算</strong>
                                            <output data-emission-preview>輸入活動量並選擇係數後顯示計算式。</output>
                                        </div>
                                    </div>
                                    <button class="btn btn-primary mt-3" type="submit" disabled="@(!hasSelectableFactors)">@(Model.EditingActivity is null ? "儲存活動" : "儲存更正")</button>
                                    </fieldset>
                                    @if (Model.EditingActivity is not null)
                                    {
                                        <a class="btn btn-link" asp-page="/Workspace" asp-route-section="lifecycle" asp-route-stage="@stageSection.Slug" asp-route-projectVersionId="@Model.ProjectVersionId">取消更正</a>
                                    }
                                </form>

                                <div class="lifecycle-saved-data">
                                    <h4>已儲存的@(FormalStageName(stageSection.Stage))資料</h4>
                                    @if (stageActivities.Length == 0)
                                    {
                                        <p class="workspace-empty">尚未儲存此階段活動。</p>
                                    }
                                    else
                                    {
                                        <ul class="workspace-records">
                                            @foreach (var activity in stageActivities)
                                            {
                                                var evidence = Model.EvidenceFiles.SingleOrDefault(item => item.ActivityDataId == activity.Id);
                                                factorsById.TryGetValue(activity.FactorVersionId, out var activityFactor);
                                                <li>
                                                    <strong>@activity.Name</strong>
                                                    <span>@ActivityKindName(Enum.Parse<ActivityDataKind>(activity.ActivityKind))／@activity.CanonicalValue @activity.CanonicalUnitCode／分配 @activity.AllocationFactor</span>
                                                    @if (activityFactor is not null)
                                                    {
                                                        var emissions = ActivityEmissionFormula.Calculate(activity.CanonicalValue, activityFactor.Value, activity.AllocationFactor);
                                                        <span class="lifecycle-calculation">係數：@activityFactor.Name／@activityFactor.Value kgCO2e／@activityFactor.DenominatorUnitCode／@activityFactor.SourceDatasetVersion</span>
                                                        <span class="lifecycle-calculation">計算：@activity.CanonicalValue × @activityFactor.Value × @activity.AllocationFactor = <strong>@emissions kgCO2e</strong></span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-danger">此筆引用的係數版本不存在，無法計算。</span>
                                                    }
                                                    @if (Model.CanEditInventory)
                                                    {
                                                        <div class="record-actions">
                                                            <a class="btn btn-sm btn-outline-primary" asp-page="/Workspace" asp-route-section="lifecycle" asp-route-stage="@stageSection.Slug" asp-route-projectVersionId="@Model.ProjectVersionId" asp-route-activityId="@activity.Id" asp-fragment="activity-editor">更正活動</a>
                                                            <form method="post" asp-page-handler="RemoveActivity" asp-route-section="lifecycle" asp-route-stage="@stageSection.Slug" asp-route-projectVersionId="@Model.ProjectVersionId" preserve-input-for="RemoveActivity-@activity.Id">
                                                                <input type="hidden" name="activityId" value="@activity.Id" />
                                                                <button class="btn btn-sm btn-outline-danger" type="submit">停用此筆</button>
                                                            </form>
                                                        </div>
                                                        <small class="text-muted">停用後不再納入新計算；原始資料、佐證與舊計算保留。</small>
                                                    }
                                                    @if (evidence is null && Model.CanEditInventory)
                                                    {
                                                        <form method="post" enctype="multipart/form-data" asp-page-handler="UploadEvidence" asp-route-section="lifecycle" asp-route-stage="@stageSection.Slug" asp-route-projectVersionId="@Model.ProjectVersionId" preserve-input-for="UploadEvidence-@activity.Id">
                                                            <input type="hidden" name="activityDataId" value="@activity.Id" />
                                                            <label class="form-label" for="evidence-@activity.Id">佐證檔案</label>
                                                            <input class="form-control" type="file" id="evidence-@activity.Id" name="evidenceFile" required />
                                                            <button class="btn btn-sm btn-outline-primary mt-1" type="submit">掃描並上傳</button>
                                                        </form>
                                                    }
                                                    else if (evidence is not null)
                                                    {
                                                        <span>佐證：@evidence.OriginalFileName／@ScanStatusName(evidence.ScanStatus)</span>
                                                        <details class="technical-details"><summary>佐證 SHA-256</summary><code>@evidence.Sha256</code></details>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </section>
                        }
                    </div>
                    }
                    else
                    {
                        <p class="workspace-empty">尚未建立盤查版本，請先完成 02–04 的分頁設定。</p>
                    }
                </div>
            </section>
        </div>
        }
    </div>

    @if (Model.Section == "calculation")
    {
    <section class="card my-4 workspace-card workspace-calculation" id="calculation">
        <div class="card-body">
            <div class="workspace-card-heading">
                <span class="workspace-step">07</span>
                <div>
                    <h2 class="h4">凍結盤查輸入並建立計算版本</h2>
                    <p>五個階段各至少需要一筆活動數據，且標準單位須符合所選係數分母。</p>
                </div>
            </div>
            @if (Model.InventoryProjects.Count > 0)
            {
            <form method="post" asp-page-handler="Calculate" asp-route-projectVersionId="@Model.ProjectVersionId" preserve-input-for="Calculate" asp-route-section="calculation">
                <input type="hidden" name="inventoryProjectVersionId" value="@Model.ProjectVersionId" />
                <button class="btn btn-success mt-3" type="submit" disabled="@(!Model.CanCalculate)">凍結輸入並計算</button>
            </form>
            @if (!Model.CanCalculate)
            {
                <p class="workspace-help mt-2">需要計算權限，且盤查須為草稿或退回補正狀態。</p>
            }
            @if (selectedPcr is not null)
            {
                <div class="workspace-subpanel mt-3">
                    <h3 class="h6">本次 PCR 計算與報告規則</h3>
                    <p>截斷門檻：@selectedPcr.CutoffThresholdPercent%（排除項目須在盤查中明確揭露）</p>
                    <p>報告四捨五入：小數 @selectedPcr.RoundingDecimalPlaces 位；內部計算保留原始精度。</p>
                    <p>報告要求：@selectedPcr.ReportingRequirements</p>
                </div>
            }
            <a class="btn btn-outline-primary mt-3" asp-page="/Reports">選擇計算版本與稽核匯出</a>
            @if (Model.HasVerifiedMfa)
            {
            <a class="btn btn-outline-success mt-3"
               asp-page="/Workspace"
               asp-page-handler="ExportExcel"
               asp-route-section="calculation"
               asp-route-projectVersionId="@Model.ProjectVersionId">匯出 Excel</a>
            }
            }
            else
            {
                <p class="workspace-empty">尚未建立盤查版本，請先完成 02–04 的分頁設定。</p>
            }
        </div>
    </section>

    @if (latestSelectedRun is not null)
    {
        var run = latestSelectedRun;
        <section class="card my-4 workspace-card" id="latest-result">
            <div class="card-body">
                <div class="workspace-card-heading">
                    <span class="workspace-step workspace-step--result">結果</span>
                    <div>
                        <h2 class="h4">最新計算結果與稽核資訊</h2>
                        <p>核對輸入雜湊、引擎版本、產品總量、警告與逐項計算明細。</p>
                    </div>
                </div>
                <dl class="row">
                    <dt class="col-sm-3">計算版本 ID</dt><dd class="col-sm-9"><code>@run.Id</code></dd>
                    <dt class="col-sm-3">輸入資料 SHA-256</dt><dd class="col-sm-9"><code>@run.InputSha256</code></dd>
                    <dt class="col-sm-3">產品總量</dt><dd class="col-sm-9">@FormatReportingDecimal(run.ProductTotal) kgCO2e</dd>
                    <dt class="col-sm-3">引擎／規則／單位版本</dt><dd class="col-sm-9">@run.EngineBuild / @run.RuleSetVersion / @run.UnitCatalogueVersion</dd>
                    <dt class="col-sm-3">快照完整性</dt>
                    <dd class="col-sm-9">@(Model.LatestManifestHashValid == true ? "SHA-256 驗證通過" : "SHA-256 驗證失敗")</dd>
                </dl>
                @if (Model.LatestReportingRules is null)
                {
                    <p class="alert alert-danger">此版本快照尚無法驗證，以下存量不得作為有效報告。請由管理者確認或還原原始快照。</p>
                }
                @if (Model.LatestWarnings.Count > 0)
                {
                    <h3 class="h5">警告與假設</h3>
                    <ul>
                        @foreach (var warning in Model.LatestWarnings)
                        {
                            <li>@warning.Message</li>
                        }
                    </ul>
                }
                @if (Model.LatestDifference is { } difference)
                {
                    <h3 class="h5">與前次計算版本比較</h3>
                    <p>產品總量差異：@FormatReportingDecimal(difference.ProductDelta) kgCO2e</p>
                    <ul>
                        @foreach (var stage in difference.Stages)
                        {
                            <li>@FormalStageName(stage.Stage)：@FormatReportingDecimal(stage.Baseline) → @FormatReportingDecimal(stage.Candidate)（差異 @FormatReportingDecimal(stage.Delta)）</li>
                        }
                    </ul>
                }
                <div class="table-responsive">
                    <table class="table">
                        <thead><tr><th>階段</th><th>活動量</th><th>係數</th><th>公式版本</th><th>排放量</th></tr></thead>
                        <tbody>
                        @foreach (var line in Model.LatestLines)
                        {
                            <tr>
                                <td>@FormalStageName((LifecycleStage)line.LifecycleStage)</td>
                                <td>@line.CanonicalActivityValue @line.ActivityUnitCode</td>
                                <td>@line.FactorValue @line.FactorUnit</td>
                                <td>@FormulaName(line.ActivityAmountFormulaId)<br />@FormulaName(line.FormulaId)</td>
                                <td>@FormatReportingDecimal(line.Emissions) @line.EmissionsUnitCode</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <p class="alert alert-warning">此結果為系統內部盤查計算，不代表已查驗、ISO 認證或取得碳標籤。</p>
            </div>
        </section>
    }
    @if (Model.Section is not "settings")
    {
    <section class="card my-4 workspace-card workspace-final-submit" id="final-submit">
        <div class="card-body">
            <div class="workspace-card-heading">
                <span class="workspace-step workspace-step--submit">提交</span>
                <div>
                    <h2 class="h4">統一提交整份盤查</h2>
                    <p>各分頁可反覆獨立儲存；確認五階段資料與不可變計算版本完成後，再一次提交送審。</p>
                </div>
            </div>
            <ul class="workspace-records">
                @if (Model.InventoryProjects.Count == 0)
                {
                    <li class="workspace-empty">尚未建立盤查版本，請先完成 02–04 基本資料設定。</li>
                }
                else
                {
                    @foreach (var inventory in Model.InventoryProjects.Where(item => item.Id == Model.ProjectVersionId))
                    {
                        var workflowStatus = Enum.Parse<InventoryWorkflowStatus>(inventory.WorkflowStatus);
                        var savedStageCount = Model.Activities
                            .Where(item => item.InventoryProjectVersionId == inventory.Id)
                            .Select(item => item.LifecycleStage)
                            .Distinct()
                            .Count();
                        var hasRun = Model.Runs.Any(item => item.ProjectVersionId == inventory.Id);
                        var hasCurrentRun = Model.CurrentRunProjectIds.Contains(inventory.Id);
                        var hasPendingFormulaRun = Model.PendingFormulaRunProjectIds.Contains(inventory.Id);
                        <li class="workspace-submit-item">
                            <div>
                                <strong>@InventoryLabel(inventory)</strong>
                                <span>已保存 @savedStageCount／5 階段｜計算版本：@(hasCurrentRun ? "目前有效" : hasPendingFormulaRun ? "公式尚待確認，暫不可提交" : hasRun ? "資料已變更，請重算" : "尚未建立")｜狀態：@WorkflowStatusName(workflowStatus)</span>
                            </div>
                            @if (Model.CanEditData && InventoryWorkflow.AllowsEditing(workflowStatus))
                            {
                                <form method="post" asp-page-handler="SubmitInventory" asp-route-section="calculation" preserve-input-for="SubmitInventory-@inventory.Id" asp-route-projectVersionId="@Model.ProjectVersionId">
                                    <input type="hidden" name="inventoryProjectVersionId" value="@inventory.Id" />
                                    <button class="btn btn-warning" type="submit" disabled="@(!hasCurrentRun || !Model.HasVerifiedMfa)">統一提交盤查</button>
                                </form>
                            }
                            else
                            {
                                <span class="workspace-status-badge">@WorkflowStatusName(workflowStatus)</span>
                            }
                        </li>
                    }
                }
            </ul>
        </div>
    </section>
    }
    }
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
