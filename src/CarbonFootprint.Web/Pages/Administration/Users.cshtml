@page
@model CarbonFootprint.Web.Pages.Administration.UsersModel
@{
    ViewData["Title"] = "系統管理者";
}

<section class="container py-4" aria-labelledby="admin-users-title">
    <h1 id="admin-users-title">系統管理者</h1>
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-success" role="status">@Model.StatusMessage</div>
    }
    <p>只有現有系統管理者可以指派其他系統管理者；每次指派都會留下全域安全稽核事件。</p>
    <table class="table">
        <thead>
            <tr><th>名稱</th><th>Email</th><th>操作</th></tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>@user.DisplayName</td>
                    <td>@user.Email</td>
                    <td>
                        <form method="post" asp-page-handler="GrantAdministrator">
                            <input type="hidden" name="userId" value="@user.Id" />
                            <button type="submit" class="btn btn-sm btn-primary">指派系統管理者</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>
