      "activities": [{ "key": "a", "stage": "RawMaterial", "kind": "Material", "factor": "f", "rawValue": 1, "rawUnit": "kg", "canonicalUnit": "kg", "allocation": 0 }],
      "expected": { "error": "分配比例必須大於 0 且小於或等於 1" }
    },
    {
      "id": "GC-005-E2",
      "title": "分配比例大於 1",
