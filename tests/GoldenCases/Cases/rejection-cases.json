      "title": "係數有效期迄日早於活動迄日一天",
      "covers": ["boundary-date", "invalid-dependency"],
      "applicableStages": ["RawMaterial"],
      "factors": [{ "key": "f", "version": 1, "value": 1, "denominator": "kg", "datasetVersion": "ds-2026", "validFrom": "2026-01-01", "validTo": "2026-12-30" }],
      "activities": [{ "key": "a", "stage": "RawMaterial", "kind": "Material", "factor": "f", "rawValue": 1, "rawUnit": "kg", "canonicalUnit": "kg" }],
      "expected": { "error": "未發布、已撤回或不在有效期" }
    },
    {
      "id": "GC-004-E2",
      "title": "活動期間跨出盤查期間一天",
      "covers": ["boundary-date"],
      "applicableStages": ["RawMaterial"],
      "factors": [{ "key": "f", "version": 1, "value": 1, "denominator": "kg", "datasetVersion": "ds-2026" }],
      "activities": [{ "key": "a", "stage": "RawMaterial", "kind": "Material", "factor": "f", "rawValue": 1, "rawUnit": "kg", "canonicalUnit": "kg", "periodStart": "2026-12-31", "periodEnd": "2027-01-01" }],
      "expected": { "error": "活動數據期間必須落在盤查期間內" }
    },
    {
      "id": "GC-005-E1",
